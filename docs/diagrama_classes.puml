@startuml

title Diagrama de Classes - Tartarugas vs. Lixo Marinho\nCCF313 - Programacao Orientada a Objetos | UFV

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #2C3E50
skinparam classFontColor white
skinparam classBackgroundColor #ECF0F1
skinparam classBorderColor #2C3E50
skinparam arrowColor #2C3E50
skinparam arrowThickness 1.5
skinparam shadowing false

' === CLASSES ABSTRATAS ===

abstract class Entidade {
    - posX : int
    - posY : int
    - ativa : boolean
    --
    + Entidade(posX : int, posY : int)
    + {abstract} atualizar() : void
    + getPosX() : int
    + getPosY() : int
    + setPosX(x : int) : void
    + setPosY(y : int) : void
    + isAtiva() : boolean
    + desativar() : void
}

abstract class TorreTartaruga {
    - nome : String
    - custo : int
    - alcance : double
    - dano : int
    - velocidadeAtaque : double
    - tempoCooldown : double
    - projetisAtivos : List~Projetil~
    --
    + TorreTartaruga(posX, posY, nome, custo, alcance, dano, vel)
    + {abstract} atacar(alvo : InimigoLixo) : void
    + atualizar() : void
    + podeAtacar() : boolean
    + reiniciarCooldown() : void
    # dispararProjetil(p : Projetil) : void
    + limparProjetisInativos() : void
    + getNome() : String
    + getCusto() : int
    + getAlcance() : double
    + getDano() : int
    + getVelocidadeAtaque() : double
    + getProjetisAtivos() : List~Projetil~
}

abstract class InimigoLixo {
    - vidaMaxima : int
    - vidaAtual : int
    - velocidade : double
    - recompensa : int
    --
    + InimigoLixo(posX, posY, vidaMaxima, velocidade, recompensa)
    + {abstract} atualizar() : void
    + receberDano(dano : int) : void
    + estaDestruido() : boolean
    + getVidaMaxima() : int
    + getVidaAtual() : int
    + getVelocidade() : double
    + getRecompensa() : int
}

' === MODULO: TOMAS - Torres Adicionais e Projeteis ===

class Projetil {
    - velocidade : double
    - dano : int
    - alvo : InimigoLixo
    - tipo : String
    --
    + Projetil(posX, posY, velocidade, dano, alvo, tipo)
    + atualizar() : void
    + getVelocidade() : double
    + getDano() : int
    + getAlvo() : InimigoLixo
    + getTipo() : String
}

class TartarugaDeCouro {
    - {static} CUSTO : int = 200
    - {static} ALCANCE : double = 4.0
    - {static} DANO : int = 60
    - {static} VELOCIDADE_ATAQUE : double = 0.8
    - {static} VELOCIDADE_PROJETIL : double = 2.5
    --
    + TartarugaDeCouro(posX : int, posY : int)
    + atacar(alvo : InimigoLixo) : void
}

class TartarugaDePente {
    - {static} CUSTO : int = 100
    - {static} ALCANCE : double = 2.5
    - {static} DANO_BASE : int = 20
    - {static} VELOCIDADE_ATAQUE : double = 2.0
    - {static} ATAQUES_PARA_CRITICO : int = 5
    - {static} VELOCIDADE_PROJETIL : double = 3.0
    - contadorAtaques : int
    --
    + TartarugaDePente(posX : int, posY : int)
    + atacar(alvo : InimigoLixo) : void
    + getContadorAtaques() : int
    + getAtaquesParaProximoCritico() : int
}

' === MODULO: LETHICIA - Base de Torres ===

class TartarugaVerde {
    --
    + TartarugaVerde(posX : int, posY : int)
    + atacar(alvo : InimigoLixo) : void
}

' === MODULO: BRUNA - Inimigos ===

class GarrafaPet {
    --
    + GarrafaPet(posX : int, posY : int)
    + atualizar() : void
}

class RedeFantasma {
    --
    + RedeFantasma(posX : int, posY : int)
    + atualizar() : void
}

class Microplastico {
    --
    + Microplastico(posX : int, posY : int)
    + atualizar() : void
}

' === MODULO: MARINA - Persistencia ===

class RegistroRanking {
    - nomeJogador : String
    - pontuacaoTotal : int
    - ondasSobrevividas : int
    --
    + RegistroRanking(nome, pontuacao, ondas)
    + compareTo(outro : RegistroRanking) : int
    + getNomeJogador() : String
    + getPontuacaoTotal() : int
    + getOndasSobrevividas() : int
}

class GerenciadorRanking {
    - records : List~RegistroRanking~
    --
    + GerenciadorRanking()
    + adicionarRegistro(nome, pontuacao, ondas) : void
    + getTopRegistros(quantidade : int) : List~RegistroRanking~
}

' === HERANCA ===

Entidade       <|-- TorreTartaruga
Entidade       <|-- InimigoLixo
Entidade       <|-- Projetil

TorreTartaruga <|-- TartarugaVerde
TorreTartaruga <|-- TartarugaDeCouro
TorreTartaruga <|-- TartarugaDePente

InimigoLixo    <|-- GarrafaPet
InimigoLixo    <|-- RedeFantasma
InimigoLixo    <|-- Microplastico

' === ASSOCIACAO / COMPOSICAO ===

TorreTartaruga "1" o-- "0..*" Projetil        : dispara >
Projetil "0..*" --> "1" InimigoLixo           : persegue >
TorreTartaruga ..> InimigoLixo                : <<usa>>
GerenciadorRanking "1" o-- "0..*" RegistroRanking : gerencia >

@enduml
